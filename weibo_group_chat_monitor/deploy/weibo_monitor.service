[Unit]
Description=Weibo monitor realtime group chat subscriber
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duty
WorkingDirectory=/home/duty/weibo_cron
ExecStart=/bin/sh -c 'exec /home/duty/weibo_cron/weibo_monitor groupchat-subscribe -config /home/duty/weibo_cron/config.groupchat.yaml >> /home/duty/weibo_cron/logs/weibo_monitor.error.log 2>&1'
Restart=on-failure
RestartSec=60
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
