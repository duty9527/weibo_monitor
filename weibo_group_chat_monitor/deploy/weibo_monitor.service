[Unit]
Description=Weibo monitor realtime group chat subscriber
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duty
WorkingDirectory=/home/duty/weibo_cron
ExecStart=/home/duty/weibo_cron/weibo_monitor groupchat-subscribe -config /home/duty/weibo_cron/config.groupchat.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
StandardOutput=append:/home/duty/weibo_cron/logs/weibo_monitor.error.log
StandardError=append:/home/duty/weibo_cron/logs/weibo_monitor.error.log

[Install]
WantedBy=multi-user.target
